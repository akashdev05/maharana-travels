# Environment and secrets
.env
.env.*
!.env.example

# Installed dependencies
/vendor/
/node_modules/

# Vite development and generated production assets
/public/hot
/public/build/

# Laravel runtime data, logs, sessions, cached views, and local leads
/storage/app/leads/*
!/storage/app/leads/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/leads/*
!/storage/framework/leads/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# Test and editor artifacts
.phpunit.result.cache
/.idea/
/.vscode/

# Local Codex workspace metadata
/.agents/
/.codex/
/.git-codex/

# Operating system artifacts
.DS_Store
Thumbs.db
